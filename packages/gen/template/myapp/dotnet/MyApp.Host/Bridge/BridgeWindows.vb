    Private Sub Subscribe(window As BridgeWindow, core As CoreWebView2, isChild As Boolean)
        window.Core = core
        window.NewWindowHandler = Sub(sender, e) OnNewWindowRequested(window, e)
        AddHandler core.NewWindowRequested, window.NewWindowHandler
        If isChild Then
            ' 開いた側の w.close() や子ウィンドウ自身の window.close()
            window.CloseHandler = Sub(sender, e) window.Form.Close()
            AddHandler core.WindowCloseRequested, window.CloseHandler
            window.TitleHandler = Sub(sender, e)
                                      If Not String.IsNullOrEmpty(core.DocumentTitle) Then window.Form.Text = core.DocumentTitle
                                  End Sub
            AddHandler core.DocumentTitleChanged, window.TitleHandler
        End If
    End Sub

    Private Shared Sub Unsubscribe(window As BridgeWindow)
