            RemoveHandler core.NewWindowRequested, window.NewWindowHandler
            If window.CloseHandler IsNot Nothing Then RemoveHandler core.WindowCloseRequested, window.CloseHandler
            If window.TitleHandler IsNot Nothing Then RemoveHandler core.DocumentTitleChanged, window.TitleHandler
        Catch ex As Exception
            ' WebView2 が先に破棄されている。購読も一緒に消えているので何もしない
            Debug.WriteLine($"[BridgeWindows] unsubscribe: {ex.Message}")
        End Try
