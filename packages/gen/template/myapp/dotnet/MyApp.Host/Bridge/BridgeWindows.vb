    Private Async Sub OnNewWindowRequested(opener As BridgeWindow, e As CoreWebView2NewWindowRequestedEventArgs)
        ' VB は大文字小文字を区別しないので、ローカル変数を uri と名付けると型 Uri の Shared メンバーが引けなくなる
        Dim target As Uri = Nothing
        If Not Uri.TryCreate(e.Uri, UriKind.Absolute, target) OrElse Not IsAppUrl(target) Then
            ' ブリッジの無い素の WebView2 窓は開かせない。外部の http(s) は既定のブラウザへ
            e.Handled = True
            If target IsNot Nothing AndAlso (target.Scheme = Uri.UriSchemeHttp OrElse target.Scheme = Uri.UriSchemeHttps) Then
                OpenInBrowser(target)
            End If
            Return
        End If

        Dim deferral = e.GetDeferral()
        Dim child As BridgeWindow = Nothing
        Try
            Dim openerSettings = opener.Core.Settings
            child = CreateWindow(opener, e.WindowFeatures)
            child.Form.Show()
            Await child.WebView.EnsureCoreWebView2Async(_environment)
            If child.Form.IsDisposed Then
                ' 初期化中に利用者が閉じた。素の窓も開かせない
                e.Handled = True
                Return
            End If
            Dim core = child.WebView.CoreWebView2
            CopySettings(openerSettings, core.Settings)
            _configure?.Invoke(core)
            child.Bridge.Attach()
            Subscribe(child, core, isChild:=True)
            _emitter.Add(child.Bridge)
            If MinimizedMemorySaver.IsAttached(opener.WebView) Then MinimizedMemorySaver.Attach(child.Form, child.WebView)
            ' ここで渡すと Navigate は WebView2 が行い、window.opener と window.open の戻り値がこの窓を指す
            e.NewWindow = core
            e.Handled = True
        Catch ex As Exception
            Debug.WriteLine($"[BridgeWindows] failed to open {e.Uri}: {ex}")
            e.Handled = True
            ' 初期化中に利用者が閉じた場合はもう破棄されている
            If child IsNot Nothing AndAlso Not child.Form.IsDisposed Then child.Form.Close()
        Finally
            deferral.Complete()
        End Try
    End Sub

    Private Function CreateWindow(opener As BridgeWindow, features As CoreWebView2WindowFeatures) As BridgeWindow
        Dim webView As New WebView2() With {
            .Dock = DockStyle.Fill,
            .DefaultBackgroundColor = opener.WebView.DefaultBackgroundColor
        }
        Dim form As New Form() With {
            .Text = opener.Form.Text,
            .Icon = opener.Form.Icon,
            .StartPosition = FormStartPosition.Manual,
            .Bounds = InitialBounds(opener, features)
        }
        form.Controls.Add(webView)
        Dim window As New BridgeWindow(form, webView, New WebViewBridge(webView, _dispatcher))
        AddHandler form.FormClosed, Sub(sender, e) OnChildClosed(window)
        _children.Add(window)
        Return window
    End Function

    Private Sub OnChildClosed(window As BridgeWindow)
        _children.Remove(window)
        _emitter.Remove(window.Bridge)
        Unsubscribe(window)
        window.Bridge.Dispose()
    End Sub

    Private Sub OnOwnerClosed(sender As Object, e As FormClosedEventArgs)
        CloseAll()
    End Sub

    ''' <summary>自アプリの URL か: appUrl と scheme・host・port が同じ（https://app.local、Debug の dev サーバー）</summary>
    Private Function IsAppUrl(target As Uri) As Boolean
        Return Uri.Compare(_appUrl, target, UriComponents.SchemeAndServer, UriFormat.SafeUnescaped, StringComparison.OrdinalIgnoreCase) = 0
    End Function

    ''' <summary>
    ''' features（CSS px）→ 物理 px の Bounds。開いた側の DPI（DeviceDpi / 96）を掛ける。
    ''' width / height は枠込みの外形として扱う（スナップのように並べたとき隣と重ならない。ブラウザでは中身の大きさなので枠の分だけ大きく出る）。
    ''' 指定が無ければ開いた側と同じ大きさで少しずらす
    ''' </summary>
    Private Shared Function InitialBounds(opener As BridgeWindow, features As CoreWebView2WindowFeatures) As Rectangle
        Dim factor = opener.WebView.DeviceDpi / 96.0
        Dim openerBounds = If(opener.Form.WindowState = FormWindowState.Normal, opener.Form.Bounds, opener.Form.RestoreBounds)
        Dim offset = ToDevicePixels(CascadeOffset, factor)
        Dim bounds As New Rectangle(openerBounds.X + offset, openerBounds.Y + offset, openerBounds.Width, openerBounds.Height)
        If features.HasSize Then
            If features.Width > 0UI Then bounds.Width = ToDevicePixels(ToSigned(features.Width), factor)
            If features.Height > 0UI Then bounds.Height = ToDevicePixels(ToSigned(features.Height), factor)
        End If
        If features.HasPosition Then
            bounds.X = ToDevicePixels(ToSigned(features.Left), factor)
            bounds.Y = ToDevicePixels(ToSigned(features.Top), factor)
        End If
        Return FitToScreen(bounds)
    End Function

    ''' <summary>そのスクリーンの作業領域（タスクバーを除く）に収める。大きすぎれば縮め、はみ出す分は内側へ詰める</summary>
    Private Shared Function FitToScreen(bounds As Rectangle) As Rectangle
        Dim area = Screen.FromRectangle(bounds).WorkingArea
        Dim width = Math.Min(bounds.Width, area.Width)
        Dim height = Math.Min(bounds.Height, area.Height)
        Dim x = Math.Max(area.Left, Math.Min(bounds.X, area.Right - width))
        Dim y = Math.Max(area.Top, Math.Min(bounds.Y, area.Bottom - height))
        Return New Rectangle(x, y, width, height)
    End Function

    Private Shared Function ToDevicePixels(value As Integer, factor As Double) As Integer
        Return CInt(Math.Round(value * factor))
    End Function

    ''' <summary>WindowFeatures は UInt32。左のモニタの負の座標がビットのまま届いたときに備えて符号付きに読み直す</summary>
    Private Shared Function ToSigned(value As UInteger) As Integer
        Return BitConverter.ToInt32(BitConverter.GetBytes(value), 0)
    End Function

    ''' <summary>
    ''' 子ウィンドウにも開いた側と同じ Settings を掛ける（Release で F12 / F5 が効かない、などを子ウィンドウでも保つ）。
    ''' SDK 1.0.4191 の CoreWebView2Settings の全項目。新しい項目は古い WebView2 Runtime だと読み書きで例外になるので、1 項目ずつ写す
    ''' </summary>
    Private Shared Sub CopySettings(source As CoreWebView2Settings, target As CoreWebView2Settings)
