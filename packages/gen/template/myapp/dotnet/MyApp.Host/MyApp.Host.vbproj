<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>MyApp.Host</RootNamespace>
    <MyType>WindowsForms</MyType>
    <StartupObject>MyApp.Host.Program</StartupObject>
    <!--
      AnyCPU のままだと Windows の dotnet build で exe は 64 ビット、WebView2Loader.dll は x86 だけ出力されて
      起動時に BadImageFormatException になる（SDK が .NET Framework exe に win7-x86 を仮定し、WebView2 の
      ローダーコピーと食い違う）。x64 に固定して揃える。32 ビット専用の DB ドライバ等が要るなら x86 にする。
    -->
    <PlatformTarget>x64</PlatformTarget>
    <WebDistDir>$(MSBuildProjectDirectory)\..\..\web\dist</WebDistDir>
    <!--
      配布の形（任意）。空なら exe の隣に DLL・WebView2Loader.dll・wwwroot が並ぶ（既定）。
      "MyApp\" にすると直下は MyApp.Host.exe と MyApp.Host.exe.config だけになり、残りはすべて MyApp\ に入る
      （共有フォルダで母艦（メニュー exe）と同じ階層に置くときなど）。
      App.config の probing privatePath と MainForm.FilesDirName がこのフォルダ名を前提にしているので、値は空か "MyApp\" のどちらかにする。
    -->
    <AppFilesDir></AppFilesDir>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" GeneratePathProperty="true" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <ProjectReference Include="..\MyApp.Contract\MyApp.Contract.vbproj" />
    <ProjectReference Include="..\MyApp.Impl\MyApp.Impl.vbproj" />
  </ItemGroup>
  <Target Name="CopyWebDist" AfterTargets="Build" Condition="Exists('$(WebDistDir)\index.html')">
    <ItemGroup><WebDistFiles Include="$(WebDistDir)\**\*" /></ItemGroup>
    <RemoveDir Directories="$(OutDir)$(AppFilesDir)wwwroot" />
    <Copy SourceFiles="@(WebDistFiles)" DestinationFiles="@(WebDistFiles->'$(OutDir)$(AppFilesDir)wwwroot\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- AppFilesDir を設定したときだけ: 参照 DLL と WebView2Loader.dll を AppFilesDir に出し、直下に残った旧配置の DLL・wwwroot を消す -->
  <PropertyGroup Condition="'$(AppFilesDir)' != ''">
    <!-- WebView2 の NuGet targets が exe 隣に置くローダーは出さず、下の None で AppFilesDir に 1 つだけ置く -->
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
  </PropertyGroup>
  <ItemGroup Condition="'$(AppFilesDir)' != ''">
    <None Include="$(PkgMicrosoft_Web_WebView2)\runtimes\win-$(PlatformTarget)\native\WebView2Loader.dll" Link="$(AppFilesDir)WebView2Loader.dll" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <Target Name="PlaceReferencesInAppFilesDir" BeforeTargets="_CopyFilesMarkedCopyLocal" Condition="'$(AppFilesDir)' != ''">
    <ItemGroup>
      <!-- WPF 版の WebView2 と、NuGet が runtimes\ 配下に置くローダーは使わない -->
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf' Or '%(Filename)' == 'WebView2Loader'" />
      <ReferenceCopyLocalPaths Update="@(ReferenceCopyLocalPaths)" DestinationSubDirectory="$(AppFilesDir)%(ReferenceCopyLocalPaths.DestinationSubDirectory)" />
    </ItemGroup>
  </Target>
  <Target Name="RemoveOldLayout" AfterTargets="Build" Condition="'$(AppFilesDir)' != ''">
    <!-- 以前の形で出力した DLL が直下に残っていると AppFilesDir より先に読まれるので消す（exe 自身の pdb は残す） -->
    <ItemGroup>
      <OldLayoutFiles Include="$(OutDir)*.dll;$(OutDir)*.pdb" Exclude="$(OutDir)$(TargetName).pdb" />
    </ItemGroup>
    <Delete Files="@(OldLayoutFiles)" />
    <RemoveDir Directories="$(OutDir)wwwroot;$(OutDir)runtimes" />
  </Target>
  <Target Name="RemoveAppFilesDirLayout" AfterTargets="Build" Condition="'$(AppFilesDir)' == ''">
    <!--
      AppFilesDir を空に戻したとき: 前の形の MyApp\ が残っていると MainForm.WwwRoot が MyApp\wwwroot を優先して古い画面が出るので消す
      （MyApp\ の DLL と WebView2Loader.dll は増分クリーンが消すが、wwwroot は Copy タスクの出力なので残る）
    -->
    <RemoveDir Directories="$(OutDir)MyApp" />
  </Target>
</Project>
