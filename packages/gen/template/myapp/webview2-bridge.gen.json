{
  "contract": "contract/contract.ts",
  "schemaOut": "contract/contract.schema.json",
  "ts": {
    "outDir": "web/src/generated",
    "contractImport": "../../../contract/contract"
  },
  "openapi": {
    "out": "contract/openapi.json",
    "title": "MyApp contract"
  },
  "markdown": {
    "out": "contract/contract.md",
    "title": "MyApp 契約仕様"
  },
  "vb": {
    "outDir": "dotnet/MyApp.Contract/Generated",
    "namespace": "MyApp.Contract",
    "runtime": {
      "outDir": "dotnet/MyApp.Contract/Runtime"
    },
    "winforms": {
      "outDir": "dotnet/MyApp.Host/Bridge"
    }
  }
}
