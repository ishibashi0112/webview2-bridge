{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "wvbridge contract",
  "type": "object",
  "properties": {
    "methods": {
      "type": "object",
      "properties": {
        "orders": {
          "type": "object",
          "properties": {
            "list": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "$ref": "#/$defs/OrderStatus"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "a",
                        "b"
                      ]
                    },
                    "page": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "pageSize": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "includeClosed": {
                      "type": "boolean"
                    },
                    "minTotal": {
                      "type": [
                        "number",
                        "null"
                      ]
                    },
                    "bigId": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991,
                      "format": "int64"
                    }
                  },
                  "required": [
                    "kind",
                    "pageSize",
                    "minTotal",
                    "bigId"
                  ],
                  "additionalProperties": false
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "total": {
                      "type": "integer",
                      "minimum": -9007199254740991,
                      "maximum": 9007199254740991
                    },
                    "rows": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "orderNo": {
                            "type": "string"
                          },
                          "status": {
                            "$ref": "#/$defs/OrderStatus"
                          },
                          "shipTo": {
                            "$ref": "#/$defs/Address"
                          },
                          "billTo": {
                            "anyOf": [
                              {
                                "$ref": "#/$defs/Address"
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "lines": {
                            "type": "array",
                            "items": {
                              "type": "object",
                              "properties": {
                                "sku": {
                                  "type": "string"
                                },
                                "qty": {
                                  "type": "integer",
                                  "minimum": -9007199254740991,
                                  "maximum": 9007199254740991
                                },
                                "unitPrice": {
                                  "type": "number"
                                }
                              },
                              "required": [
                                "sku",
                                "qty",
                                "unitPrice"
                              ],
                              "additionalProperties": false
                            }
                          },
                          "tags": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          },
                          "memo": {
                            "type": "object",
                            "properties": {
                              "text": {
                                "type": "string"
                              },
                              "date": {
                                "type": "string"
                              }
                            },
                            "required": [
                              "text"
                            ],
                            "additionalProperties": false
                          }
                        },
                        "required": [
                          "orderNo",
                          "status",
                          "shipTo",
                          "billTo",
                          "lines",
                          "tags"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "total",
                    "rows"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            },
            "cancel": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "object",
                  "properties": {
                    "orderNo": {
                      "type": "string"
                    },
                    "reason": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "orderNo"
                  ],
                  "additionalProperties": false
                },
                "output": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "ok"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "list",
            "cancel"
          ],
          "additionalProperties": false
        },
        "master-data": {
          "type": "object",
          "properties": {
            "getAddress": {
              "type": "object",
              "properties": {
                "input": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "id"
                  ],
                  "additionalProperties": false
                },
                "output": {
                  "$ref": "#/$defs/Address"
                }
              },
              "required": [
                "input",
                "output"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "getAddress"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orders",
        "master-data"
      ],
      "additionalProperties": false
    },
    "events": {
      "type": "object",
      "properties": {
        "orderChanged": {
          "type": "object",
          "properties": {
            "orderNo": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/OrderStatus"
            }
          },
          "required": [
            "orderNo",
            "status"
          ],
          "additionalProperties": false
        },
        "heartbeat": {
          "type": "object",
          "properties": {
            "at": {
              "type": "string"
            },
            "seq": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "at",
            "seq"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "orderChanged",
        "heartbeat"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "methods",
    "events"
  ],
  "additionalProperties": false,
  "$defs": {
    "OrderStatus": {
      "type": "string",
      "enum": [
        "open",
        "in-progress",
        "closed"
      ]
    },
    "Address": {
      "type": "object",
      "properties": {
        "zip": {
          "type": "string"
        },
        "line1": {
          "type": "string"
        },
        "line2": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "zip",
        "line1",
        "line2"
      ],
      "additionalProperties": false
    }
  }
}