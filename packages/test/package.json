{
  "name": "@ishibashi0112/webview2-bridge-test",
  "version": "0.4.0",
  "description": "Playwright fixtures for testing webview2-bridge apps: launch the WinForms host with CDP, call the contract from tests, verify DB changes via Knex, and emit an AI-ready Markdown report",
  "keywords": [
    "webview2",
    "winforms",
    "playwright",
    "e2e",
    "knex",
    "testing",
    "json-rpc",
    "bridge"
  ],
  "license": "MIT",
  "author": "ishibashi0112",
  "homepage": "https://github.com/ishibashi0112/webview2-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishibashi0112/webview2-bridge.git",
    "directory": "packages/test"
  },
  "bugs": "https://github.com/ishibashi0112/webview2-bridge/issues",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./reporter": "./src/reporter.ts"
  },
  "bin": {
    "webview2-bridge-test": "./src/cli.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/config.d.ts",
        "default": "./dist/config.js"
      },
      "./reporter": {
        "types": "./dist/reporter.d.ts",
        "default": "./dist/reporter.js"
      }
    },
    "bin": {
      "webview2-bridge-test": "./dist/cli.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.56.0",
    "knex": ">=3.0.0"
  },
  "peerDependenciesMeta": {
    "knex": {
      "optional": true
    }
  },
  "dependencies": {
    "tsx": "^4.23.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "better-sqlite3": "^13.0.3",
    "@types/better-sqlite3": "^9.6.0",
    "knex": "^3.3.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
