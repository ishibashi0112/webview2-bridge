{
  "name": "@ishibashi0112/webview2-bridge-client",
  "version": "0.2.0",
  "description": "Front-end runtime for webview2-bridge: typed JSON-RPC client over WebView2 postMessage (WebView2Transport), in-browser MemoryTransport for development, and zod validation on both ends",
  "keywords": [
    "webview2",
    "winforms",
    "json-rpc",
    "zod",
    "react",
    "vite",
    "postMessage",
    "bridge"
  ],
  "license": "MIT",
  "author": "ishibashi0112",
  "homepage": "https://github.com/ishibashi0112/webview2-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ishibashi0112/webview2-bridge.git",
    "directory": "packages/client"
  },
  "bugs": "https://github.com/ishibashi0112/webview2-bridge/issues",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepublishOnly": "pnpm build"
  },
  "peerDependencies": {
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
