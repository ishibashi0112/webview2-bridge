{
  "openapi": "3.1.0",
  "info": {
    "title": "webview2-bridge sample contract",
    "version": "1.0.0",
    "description": "Generated by @ishibashi0112/webview2-bridge-gen from contract.schema.json. Every contract method is `POST /<namespace>/<method>` with the input as JSON body and the output as JSON response. Errors carry a JSON-RPC error object (JsonRpcError) in the body."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "tags": [
    {
      "name": "parts",
      "description": "Methods of namespace `parts`"
    },
    {
      "name": "events",
      "description": "Host → Web notifications (Server-Sent Events)"
    }
  ],
  "security": [],
  "paths": {
    "/parts/search": {
      "post": {
        "operationId": "partsSearch",
        "x-webview2-bridge-method": "parts.search",
        "tags": [
          "parts"
        ],
        "summary": "parts.search",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PartsSearchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PartsSearchResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/InvalidParams"
          },
          "404": {
            "$ref": "#/components/responses/MethodNotFound"
          },
          "500": {
            "$ref": "#/components/responses/ServerError"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "events",
        "tags": [
          "events"
        ],
        "summary": "Server-Sent Events. Each `data:` line is one JSON-RPC notification (same as the postMessage wire format)",
        "responses": {
          "200": {
            "description": "Event stream",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jsonrpc": {
                      "type": "string",
                      "const": "2.0"
                    },
                    "method": {
                      "type": "string",
                      "const": "event.progress"
                    },
                    "params": {
                      "$ref": "#/components/schemas/ProgressEvent"
                    }
                  },
                  "required": [
                    "jsonrpc",
                    "method",
                    "params"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Part": {
        "type": "object",
        "properties": {
          "partNo": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "qty": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "string",
            "description": "ISO 8601。日付は初期は文字列で往復する（HANDOFF.md §10）"
          }
        },
        "required": [
          "partNo",
          "name",
          "qty",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "PartsSearchRequest": {
        "type": "object",
        "properties": {
          "keyword": {
            "type": "string",
            "minLength": 1
          },
          "limit": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "keyword"
        ],
        "additionalProperties": false
      },
      "PartsSearchResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Part"
            }
          }
        },
        "required": [
          "items"
        ],
        "additionalProperties": false
      },
      "ProgressEvent": {
        "type": "object",
        "properties": {
          "percent": {
            "type": "number"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "percent"
        ],
        "additionalProperties": false
      },
      "JsonRpcError": {
        "type": "object",
        "description": "JSON-RPC 2.0 error object. Same shape as the `error` member over postMessage",
        "properties": {
          "code": {
            "type": "integer",
            "description": "-32700 Parse, -32600 Invalid Request, -32601 Method not found, -32602 Invalid params, -32000.. application"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "description": "Unhandled server exceptions put the exception type name here"
          }
        },
        "required": [
          "code",
          "message"
        ]
      }
    },
    "responses": {
      "InvalidParams": {
        "description": "Invalid params (JSON-RPC -32602), invalid request (-32600) or parse error (-32700)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonRpcError"
            }
          }
        }
      },
      "MethodNotFound": {
        "description": "Method not found (JSON-RPC -32601)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonRpcError"
            }
          }
        }
      },
      "ServerError": {
        "description": "Unhandled server error (JSON-RPC -32000 or other application-defined code)",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonRpcError"
            }
          }
        }
      }
    }
  },
  "x-webview2-bridge": {
    "contractVersion": 1,
    "events": [
      {
        "name": "progress",
        "method": "event.progress",
        "schema": "#/components/schemas/ProgressEvent"
      }
    ]
  }
}
