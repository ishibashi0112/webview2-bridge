<Project Sdk="Microsoft.NET.Sdk">
  <!--
    NuGet: WebView2Bridge.WinForms（net48 / VB / WinForms）
    WebView2 コントロールと Dispatcher をつなぐ WebViewBridge。Host アプリがこれを参照する。
    ビルドは Mac / Linux でも通る（EnableWindowsTargeting）。実行は Windows のみ。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>WebView2Bridge.WinForms</RootNamespace>
    <AssemblyName>WebView2Bridge.WinForms</AssemblyName>
    <IsPackable>true</IsPackable>
    <PackageId>WebView2Bridge.WinForms</PackageId>
    <Description>WinForms glue for webview2-bridge: WebViewBridge connects a Microsoft.Web.WebView2 control to the WebView2Bridge.Runtime dispatcher (WebMessageReceived → Dispatcher → PostWebMessageAsJson) and marshals host → web notifications to the UI thread.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <ProjectReference Include="..\WebView2Bridge.Runtime\WebView2Bridge.Runtime.vbproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
