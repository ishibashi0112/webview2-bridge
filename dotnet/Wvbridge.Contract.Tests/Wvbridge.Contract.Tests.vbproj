<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Contract（Dispatcher / JsonRpc / 生成コード）の単体テスト。
    net8.0 で動かすので Mac / Linux でも `dotnet test` できる（Contract は netstandard2.0）。
    製品コードは .NET Framework 4.8 のままで、テストランナーだけモダン .NET を使う。
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Wvbridge.Contract.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.0" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wvbridge.Contract\Wvbridge.Contract.vbproj" />
  </ItemGroup>
</Project>
