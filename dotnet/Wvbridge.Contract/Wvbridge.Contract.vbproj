<Project Sdk="Microsoft.NET.Sdk">
  <!--
    契約（生成 DTO / Interface / Dispatcher）とブリッジのランタイム。
    WebView2 には依存しない。netstandard2.0 なので Mac / Linux でもビルドできる。
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Wvbridge.Contract</RootNamespace>
    <AssemblyName>Wvbridge.Contract</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
</Project>
