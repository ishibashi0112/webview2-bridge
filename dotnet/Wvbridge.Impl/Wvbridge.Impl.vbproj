<Project Sdk="Microsoft.NET.Sdk">
  <!--
    人間が書く実装（DB / サーバーとの通信）。Contract の Interface を Implements する。
    将来 SqlClient / Oracle.ManagedDataAccess などはここに閉じ込める。
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>Wvbridge.Impl</RootNamespace>
    <AssemblyName>Wvbridge.Impl</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wvbridge.Contract\Wvbridge.Contract.vbproj" />
  </ItemGroup>
</Project>
