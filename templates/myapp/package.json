{
  "name": "myapp",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "gen": "webview2-bridge-gen",
    "gen:check": "webview2-bridge-gen --check",
    "dev": "pnpm --filter web dev",
    "build:web": "pnpm --filter web build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "check": "pnpm gen:check && pnpm lint && pnpm typecheck && pnpm test",
    "test": "playwright test --project screen",
    "test:e2e": "playwright test --project api --project host",
    "test:all": "pnpm test && pnpm test:e2e",
    "test:doctor": "webview2-bridge-test doctor"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@ishibashi0112/webview2-bridge-gen": "^0.5.2",
    "@ishibashi0112/webview2-bridge-test": "^0.5.2",
    "@playwright/test": "^1.63.0",
    "knex": "^3.3.0",
    "oracledb": "^7.0.1",
    "tedious": "^20.0.0",
    "zod": "^4.6.5"
  }
}
