# 自動テスト(api / host)が使うテスト DB の接続情報。このファイルを .env.e2e.local にコピーして書く(.env.e2e.local は git に入れない)。
# 接続先が e2e/e2e.config.ts の db.allowedDatabases に無いとテストは起動時に止まる。

# SQL Server(tedious)
E2E_DB_CLIENT=mssql
E2E_DB_HOST=db01
E2E_DB_PORT=1433
E2E_DB_USER=myapp_test
E2E_DB_PASSWORD=
E2E_DB_DATABASE=MyApp_Test
# 暗号化なしの古いサーバーなら: E2E_DB_OPTIONS={"options":{"encrypt":false}}

# Oracle(oracledb thin モード)
# E2E_DB_CLIENT=oracledb
# E2E_DB_HOST=db01
# E2E_DB_PORT=1521
# E2E_DB_USER=MYAPP_TEST
# E2E_DB_PASSWORD=
# E2E_DB_DATABASE=TESTPDB           # サービス名。または E2E_DB_CONNECT_STRING=db01:1521/TESTPDB

# PostgreSQL / MySQL は E2E_DB_CLIENT=pg / mysql2(ドライバ pg / mysql2 を pnpm add -D で追加)
