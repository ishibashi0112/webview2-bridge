<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <runtime>
    <!-- 配布物を MyApp\ にまとめたとき（MyApp.Host.vbproj の AppFilesDir）、DLL をそこから読む。まとめていないときは何もしない -->
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
      <probing privatePath="MyApp" />
    </assemblyBinding>
  </runtime>
</configuration>
